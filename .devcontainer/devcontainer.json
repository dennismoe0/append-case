{
  "name": "append-case",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  // Keep the container's virtualenv outside the workspace, so it never clashes with a .venv created on the host
  "containerEnv": { "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv" },
  "postCreateCommand": "pip install uv && uv sync --all-groups",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-toolsai.jupyter"],
      "settings": { "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python" }
    }
  }
}
